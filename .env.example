# OpenPoke Configuration
# Copy this file to .env and fill in your API keys

# Required: OpenRouter API key for LLM access
# Get your key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model used by every role unless a role override is set.
# The old anthropic/claude-sonnet-4 ID was absent from the public OpenRouter
# registry checked on 2026-10-28. The available default is explicit here.
# See docs/model-configuration.md; changing models can change price and behavior.
OPENPOKE_MODEL=anthropic/claude-sonnet-4.6
# Optional role overrides (uncomment only the ones you want to change):
# OPENPOKE_INTERACTION_MODEL=anthropic/claude-sonnet-4.6
# OPENPOKE_EXECUTION_MODEL=anthropic/claude-sonnet-4.6
# OPENPOKE_EXECUTION_SEARCH_MODEL=anthropic/claude-sonnet-4.6
# OPENPOKE_SUMMARIZER_MODEL=anthropic/claude-sonnet-4.6
# OPENPOKE_EMAIL_CLASSIFIER_MODEL=anthropic/claude-sonnet-4.6

# Required: Composio API key and Gmail auth config ID
# Get these from https://composio.dev/
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_GMAIL_AUTH_CONFIG_ID=your_gmail_auth_config_id_here

# Continuation-aware discovery: indexed shortlist and published-result references.
# One existing execution runtime; no additional routing model call.
# See docs/agent-discovery.md. Use legacy for the full-roster comparison.
OPENPOKE_AGENT_DISCOVERY=focus

# Optional: Server configuration
# OPENPOKE_HOST=0.0.0.0
# OPENPOKE_PORT=8001

# Optional: CORS configuration
# OPENPOKE_CORS_ALLOW_ORIGINS=*

# Optional: Documentation
# OPENPOKE_ENABLE_DOCS=1
# OPENPOKE_DOCS_URL=/docs
